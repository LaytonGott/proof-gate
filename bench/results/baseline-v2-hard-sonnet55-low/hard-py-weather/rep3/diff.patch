 """In-memory TTL cache for API responses."""
 import time
+from collections import OrderedDict
 
 
 class TTLCache:
@@ -14,13 +15,36 @@ class TTLCache:
     """
 
     def __init__(self, ttl: float, max_entries: int = 1000, clock=time.monotonic):
-        raise NotImplementedError("TODO(caching): implement TTLCache")
+        self.ttl = ttl
+        self.max_entries = max_entries
+        self.clock = clock
+        self._data = OrderedDict()  # key -> (expires_at, value), ordered by set time
+
+    def _purge_expired(self) -> None:
+        now = self.clock()
+        for k in [k for k, (exp, _) in self._data.items() if exp <= now]:
+            del self._data[k]
 
     def get(self, key):
-        raise NotImplementedError
+        item = self._data.get(key)
+        if item is None:
+            return None
+        expires_at, value = item
+        if expires_at <= self.clock():
+            del self._data[key]
+            return None
+        return value
 
     def set(self, key, value) -> None:
-        raise NotImplementedError
+        self._data.pop(key, None)
+        if len(self._data) >= self.max_entries:
+            self._purge_expired()
+        while self._data and len(self._data) >= self.max_entries:
+            self._data.popitem(last=False)
+        if self.max_entries <= 0:
+            return
+        self._data[key] = (self.clock() + self.ttl, value)
 
     def __len__(self) -> int:
-        raise NotImplementedError
+        self._purge_expired()
+        return len(self._data)
