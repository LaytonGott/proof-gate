diff --git a/solution.py b/solution.py
index da85e31..0a3c640 100644
--- a/solution.py
+++ b/solution.py
@@ -24,4 +24,35 @@ def can_tile_grid(n: int, h: int, w: int, tiles: List[Tuple[int, int]]) -> bool:
     >>> can_tile_grid(1, 2, 2, [(1, 1)])
     False
     """
-    raise NotImplementedError
+    grid = [[False] * w for _ in range(h)]
+    used = [False] * n
+
+    def fits(r, c, a, b):
+        if r + a > h or c + b > w:
+            return False
+        return not any(grid[i][j] for i in range(r, r + a) for j in range(c, c + b))
+
+    def fill(r, c, a, b, val):
+        for i in range(r, r + a):
+            for j in range(c, c + b):
+                grid[i][j] = val
+
+    def solve():
+        pos = next(((r, c) for r in range(h) for c in range(w) if not grid[r][c]), None)
+        if pos is None:
+            return True
+        r, c = pos
+        for k, (a, b) in enumerate(tiles):
+            if used[k]:
+                continue
+            for x, y in {(a, b), (b, a)}:
+                if fits(r, c, x, y):
+                    used[k] = True
+                    fill(r, c, x, y, True)
+                    if solve():
+                        return True
+                    fill(r, c, x, y, False)
+                    used[k] = False
+        return False
+
+    return solve()
