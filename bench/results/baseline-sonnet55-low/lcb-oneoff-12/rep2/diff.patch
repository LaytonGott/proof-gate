diff --git a/solution.py b/solution.py
index 0c1b98b..8b92d6b 100644
--- a/solution.py
+++ b/solution.py
@@ -29,4 +29,33 @@ def min_operations_to_rearrange(n: int, s: str, t: str) -> int:
     >>> min_operations_to_rearrange(3, 'BBW', 'BBW')
     0
     """
-    raise NotImplementedError
+    if sorted(s) != sorted(t):
+        return -1
+    start = s + '..'
+    goal = t + '..'
+    if start == goal:
+        return 0
+    dist = {start: 0}
+    frontier = [start]
+    while frontier:
+        nxt = []
+        for cur in frontier:
+            e = cur.index('.')
+            d = dist[cur] + 1
+            for k in range(n + 1):
+                if k + 1 == e or k == e or k == e + 1:
+                    continue
+                if k < e < k + 1 or (k <= e + 1 and k + 1 >= e):
+                    continue
+                lst = list(cur)
+                lst[e], lst[e + 1] = lst[k], lst[k + 1]
+                lst[k] = lst[k + 1] = '.'
+                new = ''.join(lst)
+                if new in dist:
+                    continue
+                if new == goal:
+                    return d
+                dist[new] = d
+                nxt.append(new)
+        frontier = nxt
+    return -1
