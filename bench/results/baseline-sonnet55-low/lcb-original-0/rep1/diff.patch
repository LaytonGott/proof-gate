+    from functools import lru_cache
+
+    def count_upto(n: int) -> int:
+        if n <= 0:
+            return 0
+        digits = list(map(int, str(n)))
+        length = len(digits)
+
+        @lru_cache(maxsize=None)
+        def go(pos, rem, bal, tight, started):
+            if pos == length:
+                return 1 if started and bal == 0 and rem == 0 else 0
+            limit = digits[pos] if tight else 9
+            total = 0
+            for d in range(limit + 1):
+                nt = tight and d == limit
+                if not started and d == 0:
+                    total += go(pos + 1, 0, 0, nt, False)
+                else:
+                    total += go(pos + 1, (rem * 10 + d) % k,
+                                bal + (1 if d % 2 == 0 else -1), nt, True)
+            return total
+
+        return go(0, 0, 0, True, False)
+
+    return count_upto(high) - count_upto(low - 1)
