+    def count_upto(n: int) -> int:
+        # Count powerful integers in [1, n].
+        if n < 0:
+            return 0
+        t = str(n)
+        k = len(s)
+        if len(t) < k:
+            return 0
+        free = len(t) - k
+        total = 0
+        for i in range(free):
+            d = int(t[i])
+            total += min(d, limit + 1) * (limit + 1) ** (free - i - 1)
+            if d > limit:
+                return total
+        # prefix equals t[:free]; all digits <= limit
+        if s <= t[free:]:
+            total += 1
+        return total
+
+    return count_upto(finish) - count_upto(start - 1)
