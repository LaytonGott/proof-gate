diff --git a/solution.py b/solution.py
index 1f12da2..fd3d8e3 100644
--- a/solution.py
+++ b/solution.py
@@ -21,4 +21,27 @@ def kth_smallest_amount(coins: List[int], k: int) -> int:
     >>> kth_smallest_amount([5, 2], 7)
     12
     """
-    raise NotImplementedError
+    from math import gcd
+
+    # Signed LCMs for every non-empty subset (inclusion-exclusion)
+    terms = []
+    for mask in range(1, 1 << len(coins)):
+        l = 1
+        bits = 0
+        for i, c in enumerate(coins):
+            if mask >> i & 1:
+                bits += 1
+                l = l * c // gcd(l, c)
+        terms.append((l, 1 if bits % 2 else -1))
+
+    def count(x: int) -> int:
+        return sum(s * (x // l) for l, s in terms)
+
+    lo, hi = 1, min(coins) * k
+    while lo < hi:
+        mid = (lo + hi) // 2
+        if count(mid) >= k:
+            hi = mid
+        else:
+            lo = mid + 1
+    return lo
