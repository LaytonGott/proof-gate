 """In-memory TTL cache for API responses."""
 import time
+from collections import OrderedDict
 
 
 class TTLCache:
@@ -14,13 +15,37 @@ class TTLCache:
     """
 
     def __init__(self, ttl: float, max_entries: int = 1000, clock=time.monotonic):
-        raise NotImplementedError("TODO(caching): implement TTLCache")
+        self.ttl = ttl
+        self.max_entries = max_entries
+        self._clock = clock
+        # Insertion order == order of set(), oldest first; values are (expires_at, value).
+        self._data = OrderedDict()
+
+    def _purge_expired(self) -> None:
+        now = self._clock()
+        # All entries share one ttl, so expiry order matches insertion order.
+        while self._data:
+            key = next(iter(self._data))
+            if self._data[key][0] > now:
+                break
+            del self._data[key]
 
     def get(self, key):
-        raise NotImplementedError
+        entry = self._data.get(key)
+        if entry is None:
+            return None
+        if entry[0] <= self._clock():
+            del self._data[key]
+            return None
+        return entry[1]
 
     def set(self, key, value) -> None:
-        raise NotImplementedError
+        self._data.pop(key, None)
+        self._purge_expired()
+        while self._data and len(self._data) >= self.max_entries:
+            self._data.popitem(last=False)
+        self._data[key] = (self._clock() + self.ttl, value)
 
     def __len__(self) -> int:
-        raise NotImplementedError
+        self._purge_expired()
+        return len(self._data)
