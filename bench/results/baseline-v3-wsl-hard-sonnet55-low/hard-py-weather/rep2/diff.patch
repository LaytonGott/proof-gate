@@ -14,13 +14,32 @@ class TTLCache:
     """
 
     def __init__(self, ttl: float, max_entries: int = 1000, clock=time.monotonic):
-        raise NotImplementedError("TODO(caching): implement TTLCache")
+        self.ttl = ttl
+        self.max_entries = max_entries
+        self.clock = clock
+        self._data = {}  # key -> (expires_at, value); insertion order == set order
+
+    def _purge(self) -> None:
+        now = self.clock()
+        for k in [k for k, (exp, _) in self._data.items() if exp <= now]:
+            del self._data[k]
 
     def get(self, key):
-        raise NotImplementedError
+        entry = self._data.get(key)
+        if entry is None:
+            return None
+        if entry[0] <= self.clock():
+            del self._data[key]
+            return None
+        return entry[1]
 
     def set(self, key, value) -> None:
-        raise NotImplementedError
+        self._data.pop(key, None)
+        self._purge()
+        while self._data and len(self._data) >= self.max_entries:
+            del self._data[next(iter(self._data))]
+        self._data[key] = (self.clock() + self.ttl, value)
 
     def __len__(self) -> int:
-        raise NotImplementedError
+        self._purge()
+        return len(self._data)
