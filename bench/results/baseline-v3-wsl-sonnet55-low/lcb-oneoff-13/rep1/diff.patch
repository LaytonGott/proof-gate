@@ -13,4 +13,30 @@ def count_power_representations(n: int) -> int:
     >>> count_power_representations(1000000000000000000)
     1001003332
     """
-    raise NotImplementedError
+    def iroot(m: int, k: int) -> int:
+        r = int(round(m ** (1.0 / k)))
+        while r ** k > m:
+            r -= 1
+        while (r + 1) ** k <= m:
+            r += 1
+        return r
+
+    def mobius(k: int) -> int:
+        res = 1
+        p = 2
+        while p * p <= k:
+            if k % p == 0:
+                k //= p
+                if k % p == 0:
+                    return 0
+                res = -res
+            p += 1
+        if k > 1:
+            res = -res
+        return res
+
+    # Inclusion-exclusion over exponents: perfect powers > 1 up to n
+    total = 0
+    for k in range(2, n.bit_length() + 1):
+        total -= mobius(k) * (iroot(n, k) - 1)
+    return total + 1  # include 1
