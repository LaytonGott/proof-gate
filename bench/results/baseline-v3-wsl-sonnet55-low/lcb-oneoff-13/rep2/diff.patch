@@ -13,4 +13,31 @@ def count_power_representations(n: int) -> int:
     >>> count_power_representations(1000000000000000000)
     1001003332
     """
-    raise NotImplementedError
+    def iroot(m: int, k: int) -> int:
+        r = int(round(m ** (1.0 / k)))
+        while r ** k > m:
+            r -= 1
+        while (r + 1) ** k <= m:
+            r += 1
+        return r
+
+    def mobius(m: int) -> int:
+        res = 1
+        p = 2
+        while p * p <= m:
+            if m % p == 0:
+                m //= p
+                if m % p == 0:
+                    return 0
+                res = -res
+            p += 1
+        if m > 1:
+            res = -res
+        return res
+
+    total = 1  # x = 1
+    for b in range(2, n.bit_length() + 1):
+        mu = mobius(b)
+        if mu:
+            total -= mu * (iroot(n, b) - 1)
+    return total
