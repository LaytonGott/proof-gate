@@ -21,4 +21,25 @@ def count_powerful_integers(start: int, finish: int, limit: int, s: str) -> int:
     >>> count_powerful_integers(1000, 2000, 4, "3000")
     0
     """
-    raise NotImplementedError
+    if int(s) > finish or max(s) > str(limit):
+        return 0
+    suffix = int(s)
+    base = 10 ** len(s)
+    base_digits = limit + 1
+
+    def count_upto(n: int) -> int:
+        # count x in [0, n] with x = p * base + suffix, all digits of p <= limit
+        if n < suffix:
+            return 0
+        top = (n - suffix) // base  # max prefix value
+        # count p in [0, top] whose digits are all <= limit (p = 0 means no prefix)
+        digits = str(top)
+        total = 0
+        for i, ch in enumerate(digits):
+            d = int(ch)
+            total += min(d, base_digits) * base_digits ** (len(digits) - i - 1)
+            if d > limit:
+                return total
+        return total + 1
+
+    return count_upto(finish) - count_upto(start - 1)
