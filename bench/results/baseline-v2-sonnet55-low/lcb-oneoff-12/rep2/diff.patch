     """
-    raise NotImplementedError
+    start = s + '..'
+    goal = t + '..'
+    if start == goal:
+        return 0
+    seen = {start}
+    frontier = [start]
+    steps = 0
+    while frontier:
+        steps += 1
+        nxt = []
+        for cur in frontier:
+            e = cur.index('.')
+            for i in range(n + 1):
+                if cur[i] == '.' or cur[i + 1] == '.':
+                    continue
+                lst = list(cur)
+                lst[e], lst[e + 1] = cur[i], cur[i + 1]
+                lst[i] = lst[i + 1] = '.'
+                new = ''.join(lst)
+                if new in seen:
+                    continue
+                if new == goal:
+                    return steps
+                seen.add(new)
+                nxt.append(new)
+        frontier = nxt
+    return -1
