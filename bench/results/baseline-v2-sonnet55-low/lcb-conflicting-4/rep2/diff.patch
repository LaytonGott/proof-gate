diff --git a/solution.py b/solution.py
index 8a99151..fa5974f 100644
--- a/solution.py
+++ b/solution.py
@@ -24,4 +24,48 @@ def solve_grid(n: int, r: str, c: str) -> Optional[List[str]]:
     >>> solve_grid(3, 'AAA', 'BBB')
     None
     """
-    raise NotImplementedError
+    from itertools import combinations, permutations
+
+    options = []
+    for i in range(n):
+        opts = []
+        for cols in combinations(range(n), 3):
+            for perm in permutations('ABC'):
+                if perm[cols.index(min(cols))] != r[i]:
+                    continue
+                opts.append(dict(zip(cols, perm)))
+        options.append(opts)
+
+    top = [None] * n
+    used = [set() for _ in range(n)]
+    grid = []
+
+    def rec(i):
+        if i == n:
+            return all(len(u) == 3 for u in used)
+        for opt in options[i]:
+            if any(ch in used[j] for j, ch in opt.items()):
+                continue
+            changed = []
+            ok = True
+            for j, ch in opt.items():
+                if top[j] is None:
+                    if c[j] != ch:
+                        ok = False
+                        break
+                    top[j] = ch
+                    changed.append(j)
+            if ok:
+                for j, ch in opt.items():
+                    used[j].add(ch)
+                grid.append(''.join(opt.get(j, '.') for j in range(n)))
+                if rec(i + 1):
+                    return True
+                grid.pop()
+                for j, ch in opt.items():
+                    used[j].discard(ch)
+            for j in changed:
+                top[j] = None
+        return False
+
+    return grid if rec(0) else None
