@@ -13,4 +13,31 @@ def count_power_representations(n: int) -> int:
     >>> count_power_representations(1000000000000000000)
     1001003332
     """
-    raise NotImplementedError
+    from math import isqrt
+
+    def iroot(m, k):
+        r = int(round(m ** (1.0 / k)))
+        while r ** k > m:
+            r -= 1
+        while (r + 1) ** k <= m:
+            r += 1
+        return r
+
+    def mobius(k):
+        res, p = 1, 2
+        while p * p <= k:
+            if k % p == 0:
+                k //= p
+                if k % p == 0:
+                    return 0
+                res = -res
+            p += 1
+        return -res if k > 1 else res
+
+    total = 1  # the number 1
+    for b in range(2, n.bit_length() + 1):
+        mu = mobius(b)
+        if mu:
+            r = isqrt(n) if b == 2 else iroot(n, b)
+            total -= mu * (r - 1)
+    return total
